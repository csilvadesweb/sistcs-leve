{
  // Publica o app (pasta dist) como Cloudflare Worker com arquivos estáticos e liga o domínio leve.sistcs.com.
  // Precisa do DNS de sistcs.com na mesma conta da Cloudflare: o registro e o HTTPS são criados sozinhos.
  "name": "sistcs-leve",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "leve.sistcs.com", "custom_domain": true }
  ],
  "previews": {},
  "preview_urls": true,
  "vars": {
    "SUPABASE_URL": "https://yzcmxdbnitturlbozvqu.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_8NA8UB_55isWrQJawod7OQ_tvNKEJNz",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  }
}
